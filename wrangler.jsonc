{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "confmap",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-25",
  // Keep the *.workers.dev address; per-version preview URLs aren't needed.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything goes through the Worker first so *.workers.dev can redirect to the custom domain.
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "confmap", "database_id": "041aec11-e066-4554-a3a9-68e410763ecf", "migrations_dir": "migrations" }
  ],
  "routes": [{ "pattern": "confmap.knhdixh.com", "custom_domain": true }],
  "vars": { "APP_NAME": "confmap", "CANONICAL_HOST": "confmap.knhdixh.com" },
  // Daily refresh of stale researcher data (free plan allows cron triggers).
  "triggers": { "crons": ["17 3 * * *"] }
}
